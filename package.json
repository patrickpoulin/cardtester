{
  "name": "cardtester",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Simulate card games thousands of times and report who wins, how long games take, and which cards matter.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sim": "tsx cli/simulate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "mammoth": "^1.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "^9.3.12",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
